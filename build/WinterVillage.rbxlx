   local grille=detail("Двойная решётка BMW",Vector3.new(1.2,0.7,0.2),Vector3.new(side*0.75,0.7,-4.3),Color3.fromRGB(26,32,42))
  end
 end
 if index>=4 then
  local badge=detail("Эмблема BMW",Vector3.new(0.4,0.4,0.05),Vector3.new(0,1.5,-4.3),Color3.fromRGB(70,136,218))
  local tag=Instance.new("SurfaceGui") tag.Face,tag.CanvasSize,tag.Parent=Enum.NormalId.Front,Vector2.new(128,64),badge
  local text=Instance.new("TextLabel") text.Size,text.BackgroundTransparency,text.Text,text.TextSize=UDim2.fromScale(1,1),1,"BMW",42
  text.TextColor3,text.Parent=snow,tag
 end
 local spray=Instance.new("ParticleEmitter")
 spray.Name,spray.Texture,spray.Enabled="Снег дрифта","rbxasset://textures/particles/sparkles_main.dds",false
 spray.Rate,spray.Speed,spray.Lifetime,spray.Size=35,NumberRange.new(3,8),NumberRange.new(0.2,0.6),NumberSequence.new(0.15)
 spray.Parent=root
 for _,p in model:GetDescendants() do if p:IsA("BasePart") and p~=root then
  p.Anchored,p.Massless=false,true
  local weld=Instance.new("WeldConstraint") weld.Part0,weld.Part1,weld.Parent=root,p,p
 end end
 root.Anchored=false root:SetNetworkOwner(nil)
 local gyro=Instance.new("BodyGyro")
 gyro.Name,gyro.MaxTorque,gyro.P,gyro.D="Стабилизация транспорта",Vector3.new(80000,80000,80000),20000,800
 gyro.CFrame,gyro.Parent=CFrame.new(),root
 local drive=Instance.new("BodyVelocity")
 drive.Name,drive.P,drive.MaxForce,drive.Velocity="Привод транспорта",10000,Vector3.zero,Vector3.zero
 drive.Parent=root
 local vehicle={model=model,root=root,driver=driver,passenger=passenger,drive=drive,speed=0,yaw=0,steer=0,throttle=0,boost=false,untilInput=0,fires=jetFires,velocity=Vector3.zero,drift=false,spray=spray,maxSpeed=({55,90,68,78,85})[index]}
 table.insert(spawnVehicles,vehicle)
 local function board(player,seat)
  local character=player.Character local humanoid=character and character:FindFirstChildOfClass("Humanoid")
  if not humanoid or humanoid.Health<=0 or humanoid.Sit or seat.Occupant then return end
  removeSkates(player)
  character:PivotTo(seat.CFrame*CFrame.new(0,2,0)) seat:Sit(humanoid)
 end
 prompt(driver,"Водитель: сесть",function(player) board(player,driver) end)
 prompt(passenger,"Пассажир: сесть",function(player) board(player,passenger) end,"F")
 sign(root,name.." • два места\nW/S — скорость • A/D — поворот",Vector3.new(0,5,0))
 local function syncDriver()
  local occupant=driver.Occupant
  local nextPlayer=occupant and Players:GetPlayerFromCharacter(occupant.Parent)
  if nextPlayer==vehicle.player then return end
  if vehicle.player then
   groundDrivers[vehicle.player]=nil vehicle.player:SetAttribute("GroundDriving",nil) vehicle.player:SetAttribute("GroundSpeed",nil)
  end
  vehicle.player=nil vehicle.steer,vehicle.throttle,vehicle.boost=0,0,false
  local humanoid=driver.Occupant
  local player=humanoid and Players:GetPlayerFromCharacter(humanoid.Parent)
  if player then
   vehicle.player=player groundDrivers[player]=vehicle root:SetNetworkOwner(nil)
   player:SetAttribute("GroundDriving",name)
   player:SetAttribute("WinterMessage",name..": W/S — разгон и торможение, A/D — поворот, прыжок — выйти"..(index==2 and ", Shift — форсаж" or ""))
  end
 end
 vehicle.syncDriver=syncDriver
 driver:GetPropertyChangedSignal("Occupant"):Connect(syncDriver)
 passenger:GetPropertyChangedSignal("Occupant"):Connect(function() root:SetNetworkOwner(nil) end)
end
RunService.Heartbeat:Connect(function(dt)
 dt=math.min(dt,0.1)
 for _,vehicle in spawnVehicles do
  vehicle.syncDriver()
  local steer,throttle,boost=0,0,false
  if vehicle.player and os.clock()<vehicle.untilInput then steer,throttle,boost=vehicle.steer,vehicle.throttle,vehicle.boost end
  if throttle~=0 then vehicle.speed=vehicle.speed+throttle*36*dt
  else vehicle.speed=vehicle.speed*math.exp(-(vehicle.drift and 0.45 or 2)*dt) end
  vehicle.speed=math.clamp(vehicle.speed,-16,boost and vehicle.maxSpeed==90 and 125 or vehicle.maxSpeed)
  local drifting=vehicle.drift and vehicle.player~=nil and os.clock()<vehicle.untilInput and math.abs(vehicle.speed)>8
  vehicle.yaw-=steer*(drifting and 2.6 or 1.7)*dt*math.min(math.abs(vehicle.speed)/12,1)*(vehicle.speed>=0 and 1 or -1)
  local direction=Vector3.new(-math.sin(vehicle.yaw),0,-math.cos(vehicle.yaw))
  local powered=vehicle.player and vehicle.driver.Occupant and vehicle.driver.Occupant.Health>0
  local force=powered and math.max(50000,vehicle.root.AssemblyMass*400) or 0
  vehicle.drive.MaxForce=Vector3.new(force,0,force)
  local desired=direction*vehicle.speed
  vehicle.velocity=vehicle.velocity:Lerp(desired,1-math.exp(-(drifting and 1.35 or 12)*dt))
  local params=RaycastParams.new() params.FilterType=Enum.RaycastFilterType.Exclude
  local excluded={vehicle.model}
  if vehicle.player and vehicle.player.Character then table.insert(excluded,vehicle.player.Character) end
  if vehicle.passenger.Occupant then table.insert(excluded,vehicle.passenger.Occupant.Parent) end
  params.FilterDescendantsInstances=excluded
  local ground=workspace:Raycast(vehicle.root.Position+Vector3.new(0,3,0),Vector3.new(0,-12,0),params)
  local ahead=workspace:Raycast(vehicle.root.Position+direction*3.5+Vector3.new(0,4,0),Vector3.new(0,-14,0),params)
  local normal=(ahead and ahead.Normal) or (ground and ground.Normal) or Vector3.new(0,1,0)
  local tangent=direction-normal*direction:Dot(normal)
  if tangent.Magnitude<0.01 then tangent=direction end
  vehicle.drive.Velocity=vehicle.velocity
  vehicle.root:FindFirstChild("Стабилизация транспорта").CFrame=CFrame.lookAt(Vector3.zero,tangent,normal)
  vehicle.spray.Enabled=drifting and math.abs(steer)>0.1
  vehicle.model:SetAttribute("Drifting",vehicle.spray.Enabled)
  for _,fire in vehicle.fires do fire.Enabled=vehicle.speed>5 fire.Size=boost and 4 or 2 end
  if vehicle.player then vehicle.player:SetAttribute("GroundSpeed",math.floor(math.abs(vehicle.speed))) end
  if math.abs(vehicle.root.Position.X)>880 or math.abs(vehicle.root.Position.Z)>680 then
   vehicle.speed=0
   vehicle.model:PivotTo(CFrame.new(math.clamp(vehicle.root.Position.X,-870,870),3,math.clamp(vehicle.root.Position.Z,-670,670)))
  end
 end
end)
Players.PlayerRemoving:Connect(function(player)
 local vehicle=groundDrivers[player]
 if vehicle then vehicle.player=nil vehicle.throttle,vehicle.steer=0,0 end
 groundDrivers[player]=nil
end)

