  seat.Position,seat.Color,seat.Parent=position+Vector3.new((index==1 or bike) and 0 or (seatIndex==1 and -1.2 or 1.2),1.1,(index==1 or bike) and (seatIndex==1 and -0.4 or 2) or 0.5),Color3.fromRGB(48,47,58),model
 end
 detail("Руль",Vector3.new(2.4,0.2,0.2),driver.Position-position+Vector3.new(0,1,-1.4),gold,Enum.Material.Metal)
