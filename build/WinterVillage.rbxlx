<roblox version="4">
  <Item class="Lighting" referent="0">
    <Properties>
      <string name="Name">Lighting</string>
      <Color3 name="Ambient">
        <R>0.32</R>
        <G>0.38</G>
        <B>0.55</B>
      </Color3>
      <float name="Brightness">2</float>
      <float name="ClockTime">19</float>
