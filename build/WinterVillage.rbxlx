 sign(body,"Мама Настя • макарошки и уют",Vector3.new(0,5,0))
 -- A seated parent and a self-contained animated holiday television upstairs.
 local function setupDad()
  local dad=Instance.new("Model") dad.Name="Папа смотрит телевизор" dad.Parent=world
  local origin=Vector3.new(x-12,18.2,z-12)
  local torso=part("Папа",Vector3.new(2.8,3,1.5),origin,Color3.fromRGB(71,104,158),Enum.Material.Fabric,dad)
  round("Голова папы",Vector3.new(1.8,2,1.8),origin+Vector3.new(0,2.4,0),Color3.fromRGB(243,199,163),dad)
  round("Волосы папы",Vector3.new(1.9,0.7,1.8),origin+Vector3.new(0,3.1,0),Color3.fromRGB(72,49,40),dad)
  for _,side in {-1,1} do
   round("Глаза папы",Vector3.new(0.16,0.16,0.12),origin+Vector3.new(side*0.33,2.5,0.85),Color3.new(0,0,0),dad)
   rod("Рука папы",origin+Vector3.new(side*1.6,0.8,0),origin+Vector3.new(side*1.6,-1,1.1),0.4,Color3.fromRGB(243,199,163),dad)
   rod("Брюки папы",origin+Vector3.new(side*0.7,-1.5,0),origin+Vector3.new(side*0.7,-1.5,2.6),0.48,Color3.fromRGB(54,61,76),dad,Enum.Material.Fabric)
   rod("Голень папы",origin+Vector3.new(side*0.7,-1.5,2.6),origin+Vector3.new(side*0.7,-3,2.6),0.4,Color3.fromRGB(54,61,76),dad)
   part("Тапочки папы",Vector3.new(1,0.5,1.6),origin+Vector3.new(side*0.7,-3.2,2.9),green,Enum.Material.Fabric,dad)
  end
  local remote=part("Пульт телевизора",Vector3.new(0.4,0.15,0.9),origin+Vector3.new(1.6,-0.8,1.2),Color3.fromRGB(30,33,40),nil,dad)
  for _,item in dad:GetDescendants() do
   if item:IsA("BasePart") and item~=torso then
    local weld=Instance.new("WeldConstraint") weld.Part0,weld.Part1,weld.Parent=torso,item,torso
   end
  end
  local cabinet=build("Тумба телевизора",Vector3.new(11,2,3),Vector3.new(-12,15.8,3))
  local tv=build("Телевизор",Vector3.new(11,6.4,0.5),Vector3.new(-12,20,3),Color3.fromRGB(26,31,40),Enum.Material.SmoothPlastic)
  local screen=Instance.new("SurfaceGui") screen.Face=Enum.NormalId.Back screen.CanvasSize=Vector2.new(660,360) screen.Parent=tv
  -- Dad sits behind the screen's front face (negative Z).
  screen.Face=Enum.NormalId.Front
  local picture=Instance.new("TextLabel") picture.Size=UDim2.fromScale(1,1)
  picture.BackgroundColor3=Color3.fromRGB(19,45,73) picture.TextColor3=snow picture.TextSize=38
  picture.Text="❄ НОВОГОДНИЙ КАНАЛ ❄" picture.Parent=screen
  local frames={"❄ НОВОГОДНИЙ КАНАЛ ❄","☃ Зимняя сказка ☃","Ёлочка, огоньки и подарки!","С праздником! ♥"}
  light(tv,Color3.fromRGB(137,193,255),15,0.35)
  sign(torso,"Папа • смотрит новогодний телевизор",Vector3.new(0,5,0))
  prompt(torso,"Поговорить с папой",function(player)
   player:SetAttribute("WinterMessage","Папа: Присаживайся рядом! Смотрим новогоднюю передачу, пока снаружи метель.")
  end)
  local seat=Instance.new("Seat") seat.Name="Посмотреть телевизор с папой" seat.Size=Vector3.new(3,0.4,3)
  seat.Position=origin+Vector3.new(3, -1.6,0) seat.Orientation=Vector3.new(0,180,0)
  seat.Anchored=true seat.Transparency=1 seat.Parent=world
  prompt(seat,"Сесть смотреть телевизор",function(player)
   local humanoid=player.Character and player.Character:FindFirstChildOfClass("Humanoid")
   if humanoid and not seat.Occupant then seat:Sit(humanoid) end
  end)
  task.spawn(function()
   local frame=1
   while tv.Parent do
    picture.Text=frames[frame] frame=frame%#frames+1
    task.wait(4)
   end
  end)
 end
 setupDad()
 local state={active=false,elapsed=0,cycle=0,planted=0,trees=forestTrees}
 local function sheltered(pos)
  if math.abs(pos.X-x)<20.5 and math.abs(pos.Z-z)<18.5 and pos.Y>0 and pos.Y<26 then return true end
  for _,center in houseCenters do
   if math.abs(pos.X-center[1])<13.5 and math.abs(pos.Z-center[2])<12.5 and pos.Y>0 and pos.Y<14 then return true end
  end
  return false
 end
 state.sheltered=sheltered
 prompt(body,"Попросить макарошки",function(player)
  player:SetAttribute("WinterMessage",state.active and "Настя: Буря снаружи! Садись, кушай макарошки и оставайся до её конца." or "Настя: Заходи, я приготовила макарошки! Здесь всегда можно отдохнуть.")
  if player.Backpack:FindFirstChild("Макарошки") or player.Character:FindFirstChild("Макарошки") then return end
  local tool=Instance.new("Tool") tool.Name="Макарошки" tool.RequiresHandle=true
  local bowl=part("Handle",Vector3.new(1.4,0.35,1.4),Vector3.zero,snow,Enum.Material.SmoothPlastic,tool)
  bowl.Anchored,bowl.CanCollide,bowl.Massless=false,false,true
  for i=1,9 do
   local noodle=part("Макароны",Vector3.new(0.45,0.16,0.17),Vector3.new((i%3-1)*0.35,0.25,math.floor((i-1)/3)*0.3-0.3),gold,nil,tool)
   noodle.Anchored,noodle.CanCollide,noodle.Massless=false,false,true
   local weld=Instance.new("WeldConstraint") weld.Part0,weld.Part1,weld.Parent=bowl,noodle,bowl
  end
  local last=-10
  tool.Activated:Connect(function()
   if tool.Parent~=player.Character or os.clock()-last<3 then return end
   last=os.clock()
   local humanoid=player.Character:FindFirstChildOfClass("Humanoid")
   if humanoid and humanoid.Health>0 then humanoid.Health=math.min(humanoid.MaxHealth,humanoid.Health+15) end
   tool.Grip=CFrame.new(0,-0.5,-0.6)*CFrame.Angles(-1,0,0)
   player:SetAttribute("WinterMessage","Вкусные макарошки! +15 здоровья")
   task.delay(0.8,function() if tool.Parent then tool.Grip=CFrame.new() end end)
  end)
  tool.Parent=player.Backpack
 end)
 local function giveSeed(player)
  player:SetAttribute("FirSaplings",(player:GetAttribute("FirSaplings") or 0)+1)
  if player.Backpack:FindFirstChild("Посадить ёлочку") or player.Character:FindFirstChild("Посадить ёлочку") then return end
  local tool=Instance.new("Tool") tool.Name="Посадить ёлочку" tool.RequiresHandle=false
  tool.Activated:Connect(function()
   local root=player.Character and player.Character:FindFirstChild("HumanoidRootPart")
   if tool.Parent~=player.Character or not root or (player:GetAttribute("FirSaplings") or 0)<1 then return end
   local pos=root.Position+root.CFrame.LookVector*6
   if sheltered(pos) or math.abs(pos.X)>500 or math.abs(pos.Z)>600 or pos.Y>10 or state.planted>=40 then
    player:SetAttribute("WinterMessage","Посади ёлочку на свободной снежной поляне в парке") return
   end
   for _,obstacle in navigationObstacles do
    if (Vector3.new(pos.X,0,pos.Z)-Vector3.new(obstacle.x,0,obstacle.z)).Magnitude<obstacle.radius+5 then
     player:SetAttribute("WinterMessage","Здесь тесно: отойди от деревьев и построек") return
    end
   end
   player:SetAttribute("FirSaplings",player:GetAttribute("FirSaplings")-1)
   state.planted+=1
   tree(pos.X,pos.Z,12)
   player:SetAttribute("WinterMessage","Ёлочка посажена! Спасибо за восстановление леса ♥")
  end)
  tool.Parent=player.Backpack
 end
 local function breakTrees()
  local broken=0
  for _,entry in forestTrees do
   if not entry.broken and entry.height>=16 and (math.abs(entry.x)>160 or math.abs(entry.z)>160) then
    entry.broken=true entry.model:Destroy()
    local stump=part("Пень после бури",Vector3.new(1.4,1.5,1.4),Vector3.new(entry.x,0.75,entry.z),wood,Enum.Material.Wood)
    local log=rod("Сломанный ствол",Vector3.new(entry.x+2,0.9,entry.z),Vector3.new(entry.x+10,0.9,entry.z+3),0.65,wood)
    local seed=part("Саженец ёлки",Vector3.new(0.4,1.5,0.4),stump.Position+Vector3.new(2,0.5,2),wood,Enum.Material.Wood)
    round("Хвоя саженца",Vector3.new(1,1.5,1),seed.Position+Vector3.new(0,0.6,0),green,seed)
    local taken=false
    prompt(seed,"Подобрать саженец",function(player)
     if taken then return end taken=true giveSeed(player) seed:Destroy()
     player:SetAttribute("WinterMessage","Саженец найден! Выбери «Посадить ёлочку» и нажми на свободной поляне")
    end)
    Debris:AddItem(stump,300) Debris:AddItem(log,300) Debris:AddItem(seed,300)
    broken+=1 if broken>=3 then break end
   end
  end
 end
 local function announce(message)
  for _,player in Players:GetPlayers() do player:SetAttribute("WinterMessage",message) end
 end
 function state.step(seconds)
  state.elapsed+=seconds
  if not state.active and state.elapsed>=150 then
   state.active=true state.elapsed=0 state.cycle+=1
   workspace:SetAttribute("BlizzardActive",true)
   announce("Надвигается снежная буря! Через 10 секунд станет опасно. Настя ждёт в двухэтажном доме у леса!")
   breakTrees()
  elseif state.active and state.elapsed>=90 then
   state.active=false state.elapsed=0 workspace:SetAttribute("BlizzardActive",false)
   announce("Буря закончилась! Можно гулять и восстанавливать лес: ищите саженцы возле сломанных деревьев.")
  end
  for _,player in Players:GetPlayers() do
   local root=player.Character and player.Character:FindFirstChild("HumanoidRootPart")
   local humanoid=player.Character and player.Character:FindFirstChildOfClass("Humanoid")
   local safe=root and sheltered(root.Position) or false
   player:SetAttribute("StormSheltered",safe)
   if state.active and state.elapsed>=10 and root and humanoid and humanoid.Health>0 and not safe then humanoid:TakeDamage(4*seconds) end
  end
 end
 workspace:SetAttribute("BlizzardActive",false)
 local beacon=build("Дом Насти — укрытие от бури",Vector3.new(2,5,2),Vector3.new(0,3,25),gold)
 sign(beacon,"Двухэтажный дом Насти\nМакарошки • укрытие от бури",Vector3.new(0,5,0))
 local direction=part("Указатель к Насте",Vector3.new(2,4,2),Vector3.new(24,2,46),gold)
 sign(direction,"Дом мамы Насти →\nУ леса: справа и вперёд от ёлки",Vector3.new(0,5,0))
 task.spawn(function() while world.Parent do task.wait(1) state.step(1) end end)
 return state
end
local stormState=setupBlizzard()
