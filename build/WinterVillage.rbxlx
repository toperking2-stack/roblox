 end
 for i=0,9 do build("Перила второго этажа",Vector3.new(0.3,3,0.3),Vector3.new(10,16,-8+i*2.8),snow) end
 build("Поручень",Vector3.new(0.4,0.4,28),Vector3.new(10,17.5,5),snow)
