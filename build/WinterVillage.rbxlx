 if not vehicle.driver.Occupant or vehicle.driver.Occupant.Health<=0 or vehicle.driver.Occupant.Parent~=player.Character then return end
 vehicle.steer,vehicle.throttle,vehicle.boost,vehicle.untilInput,vehicle.drift=input.X,input.Y,input.Z>0,os.clock()+0.5,drift==true
end)
