 local hearth=build("Камин Насти",Vector3.new(7,1,3),Vector3.new(0,2,-16),Color3.fromRGB(70,55,51),Enum.Material.Brick)
 local fire=Instance.new("Fire") fire.Size,fire.Heat,fire.Parent=4,3,hearth light(hearth,gold,24,1)
 local tableTop=build("Обеденный стол",Vector3.new(10,0.6,6),Vector3.new(-6,4,4))
 for _,dx in {-10,-2} do build("Ножка стола",Vector3.new(0.6,3,0.6),Vector3.new(dx,2.5,4)) end
 local mom=Instance.new("Model") mom.Name="Мама Настя" mom.Parent=world
 local body=part("Настя",Vector3.new(2.6,3.2,1.5),Vector3.new(x-8,4,z-5),Color3.fromRGB(111,151,140),Enum.Material.Fabric,mom)
 round("Голова",Vector3.new(1.7,1.9,1.7),body.Position+Vector3.new(0,2.4,0),Color3.fromRGB(248,207,173),mom)
 round("Причёска",Vector3.new(1.9,1,1.9),body.Position+Vector3.new(0,3,0),Color3.fromRGB(99,60,36),mom)
 for _,side in {-1,1} do
  rod("Рука Насти",body.Position+Vector3.new(side*1.5,1,0),body.Position+Vector3.new(side*1.7,-1,0),0.36,Color3.fromRGB(248,207,173),mom)
  part("Нога Насти",Vector3.new(0.8,1.5,1),body.Position+Vector3.new(side*0.7,-2,0),wood,nil,mom)
  round("Глаза",Vector3.new(0.16,0.16,0.12),body.Position+Vector3.new(side*0.33,2.55,-0.81),Color3.new(0,0,0),mom)
