    wheel.Shape,wheel.CanCollide=Enum.PartType.Cylinder,true
    local hub=detail("Диск колеса",Vector3.new(0.85,1.25,1.25),Vector3.new(0,-0.5,z),Color3.fromRGB(170,182,197),Enum.Material.Metal)
